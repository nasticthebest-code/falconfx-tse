# Provider selection
TSE_PROVIDER=tomtom
TSE_SIMULATION_SCENARIO=free_flow

# Never commit the real value. Store it as a Replit Secret instead.
TOMTOM_API_KEY=

# Cache and provider tuning
TSE_CACHE_TTL_SECONDS=120
TSE_REFRESH_INTERVAL_SECONDS=120
TSE_REQUEST_TIMEOUT_SECONDS=5
TSE_MONITORED_CORRIDORS=N1,Spintex,Legon,Madina,Airport,Circle,Lapaz,Achimota

# Internal diagnostics
TSE_DEBUG_ENDPOINT_ENABLED=true
TSE_INTERNAL_DEBUG_TOKEN=